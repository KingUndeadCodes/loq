_a(x) = x;
_b(x, y) = x + y;
_c(x, y, z) = x + y + z;
_d(x, y, z, a) = x + y + z + a;
_e(x, y, z, a, b) = x + y + z + a + b;
_f(x, y, z, a, b, c) = x + y + z + a + b + c;
_g(x, y, z, a, b, c, h) = x + y + z + a + b + c + h;
_h(x, y, z, a, b, c, h, i) = x + y + z + a + b + c + h + i;
_i(x, y, z, a, b, c, h, i, k) = x + y + z + a + b + c + h + i + k;

// print f();
print _a(5);
print _b(10, 8);
print _c(10, 9, 3);
print _d(10, 9, 3, 2);